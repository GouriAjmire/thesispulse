# Copy this file to .env and choose your own values.
POSTGRES_DB=thesispulse
POSTGRES_USER=thesispulse
POSTGRES_PASSWORD=choose-a-strong-db-password

# Login for the /admin dashboard
ADMIN_USER=admin
ADMIN_PASSWORD=choose-a-strong-admin-password

# Browser origins allowed to call the API directly (the Docker setup proxies /api, so this is mostly for dev)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# SMTP settings for contact-form enquiry notifications (use a Gmail app password, not your account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
ENQUIRY_RECIPIENT=gouriajmire@gmail.com
